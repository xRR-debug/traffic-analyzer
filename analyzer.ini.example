# analyzer.ini — настройки TrafficAnalyzer.
#
# Скопируйте этот файл в analyzer.ini рядом с analyzer.exe (или в каталог,
# из которого запускаете программу) и раскомментируйте нужные строки.
# Все строки необязательны: чего нет в файле — берётся значение по умолчанию
# (оно указано в закомментированной строке).
#
# Формат: ключ = значение. Комментарий — только ЦЕЛОЙ строкой, начинается
# с '#' или ';' (в конце строки комментарии не поддерживаются: эти символы
# могут встретиться в самом значении). [Секции] — только для удобства чтения.
# Файл в кодировке UTF-8.

[general]
# Ключи API не нужны: режимы 3 и 6 работают через Globalping без ключа.
# Строку probeops_api_key из старых версий удалите (программа о ней предупредит).

# Окно: страна/ASN адресов сразу после загрузки дампа (1) или только по
# кнопке «Резолв ASN» (0). Адреса отправляются в ip-api.com / ipwho.is / ipapi.is.
# auto_resolve = 1

# Локальная база IP2Proxy (файл .BIN): какие адреса — VPN-серверы, выходы Tor,
# открытые прокси, дата-центры, резидентные прокси. Проверка идёт по файлу,
# без интернета, вместе с «Резолв ASN» и в режиме 13. VPN / Tor / открытый
# прокси из базы засчитываются в вердикт VPN так же, как флаги ipapi.is.
# Бесплатная база LITE (PX2…PX12 LITE, BIN, IPv4 или IPv4+IPv6) —
# lite.ip2location.com после регистрации; ZIP распаковать. Лицензия LITE —
# CC BY-SA 4.0: «This site or product includes IP2Proxy LITE data available
# from https://lite.ip2location.com». Базу стоит обновлять раз в месяц.
# Относительный путь — от папки, где лежит этот analyzer.ini.
# ip2proxy_db = IP2PROXY-LITE-PX2.BIN

[thresholds]
# «Хвост» дампа, мс: запрос/ClientHello в последние N мс без ответа не
# считается проблемой — ответ мог не попасть в запись.
# tail_ms = 3000

# «Заморозка ~16 КБ» (ТСПУ к зарубежному хостингу): соединение приняло от
# freeze_min_kb до freeze_max_kb, затем freeze_silence_ms без новых данных
# и минимум freeze_later_pkts пакетов впустую.
# freeze_min_kb = 10
# freeze_max_kb = 32
# freeze_silence_ms = 5000
# freeze_later_pkts = 3

# Блокировка рукопожатия: столько SYN к адресу без единого ответа.
# tspu_min_syn = 6

# Обходчик DPI (split): столько соединений с первым сегментом 1–5 байт.
# split_min_conns = 2

# Вердикт режима 1: потолок баллов за «форму» трафика (доля узла, гео,
# число хостов) и за потоковые признаки (Reality, JA4, долгий поток).
# Пороги вердикта постоянные: от 3 баллов «ВЕРОЯТНО», от 1 — «ВОЗМОЖНО».
# Поэтому shape_cap не больше 2 (одна «форма» не должна давать «ВЕРОЯТНО»),
# flow_score_cap не больше 5 (больше набрать нельзя); лишнее урезается
# с предупреждением.
# shape_cap = 2
# flow_score_cap = 4

# «Долгий двусторонний поток» к хостингу: длительность, сек; принято и
# отправлено, КБ (плюс исходящих не меньше 3% от входящих). 977 КБ ≈ 1 МБ.
# long_flow_sec = 120
# long_flow_min_in_kb = 977
# long_flow_min_out_kb = 100

[ports]
# Таблицы ЗАМЕНЯЮТ встроенные целиком (не дополняют) — перечисляйте все
# нужные порты. Формат: порт:название, через запятую. Пустое значение —
# пустая таблица.
# vpn_udp_ports = 51820:WireGuard, 51821:WireGuard/Amnezia, 55555:AmneziaWG, 500:IKE/IPsec, 4500:IPsec NAT-T, 1194:OpenVPN(udp), 1195:OpenVPN(udp), 1701:L2TP, 4790:OpenConnect/ESP, 8388:Shadowsocks(udp), 8443:Hysteria2/QUIC, 36712:Hysteria, 1935:Hysteria, 2408:WARP/WireGuard, 1637:WARP
# vpn_tcp_ports = 1194:OpenVPN(tcp), 1195:OpenVPN(tcp), 1723:PPTP, 8388:Shadowsocks, 8389:Shadowsocks, 10808:v2ray/xray SOCKS, 10809:v2ray/xray HTTP
# proxy_ports = 1080:SOCKS5, 3128:Squid/HTTP-proxy, 8080:HTTP-proxy, 8118:Privoxy, 8123:Polipo-proxy, 8888:HTTP-proxy-alt, 9050:Tor, 9051:Tor-control, 4433:XTLS/Reality, 4443:XTLS/Reality, 10810:v2ray/xray, 41641:Tailscale

# Наборы портов для режима 7 (скан): top / service / vpn. Просто номера.
# scan_top_ports = 21,22,23,25,53,80,110,143,443,445,465,587,993,995,1194,1195,1701,1723,1935,2052,2053,2082,2083,2086,2087,2095,2096,2121,2122,2408,3128,3389,3724,4244,4500,5060,5938,6379,8000,8080,8388,8443,8800,9000,10000,18080,19132,27015,27036,28015,30000,30120,36712,44405,500,1637,51820,51821,55555,1080,3306,5432,5900,8089
# scan_service_ports = 21,22,23,25,53,80,110,111,135,139,143,389,443,445,465,587,636,993,995,1433,1521,2049,3306,3389,5432,5900,5985,5986,6379,8000,8080,8443,8888,9000,9090,9200,11211,27017
# scan_vpn_ports = 500,1194,1195,1637,1701,1723,4500,2408,36712,51820,51821,55555,8388,8443,4433,4443,2052,2053,2082,2083,2086,2087,2095,2096,9000

[isp]
# Своя сеть оператора — не помечается «хостингом», даже если geo-API так
# считает. Подстроки названия организации и номера AS, через запятую.
# Без own_isp_asn AS своей сети задаётся кнопкой «Определить» во вкладке
# «Настройки»: программа спрашивает ip-api.com, чья сеть у её собственного
# адреса, и запоминает ответ (Windows — реестр
# HKCU\Software\MARYNONET\TrafficAnalyzer, macOS —
# ~/Library/Application Support/TrafficAnalyzer/state.ini). Нажимать из сети
# оператора без VPN. Консоль и --batch берут запомненное значение.
# own_isp_asn важнее запомненного; own_isp_org дополняет его.
# own_isp_org = maryno
# own_isp_asn = 39709

[vpn_whitelist]
# Белый список VPN: крупные сервисы. Их адреса не дают баллов VPN (порты,
# флаги баз, доля трафика, гео, MSS) и не называются VPN; проблемы соединения
# (ТСПУ, 16 КБ, потери) по ним проверяются как обычно.
# Адрес в списке, если его AS есть в vpn_whitelist_asn ИЛИ DNS в этом же дампе
# разрезолвил в него имя из vpn_whitelist_domains (суффикс: youtube.com
# покрывает и www.youtube.com). Один SNI не в счёт: Reality ставит в SNI как раз
# vk.com / gosuslugi.ru, а ведёт на VPS.
# Сигнатуры (WireGuard, OpenVPN, прокси по содержимому) срабатывают и здесь.
# Облака (Google Cloud AS396982, Yandex Cloud AS200350, VK Cloud) не добавляйте:
# там стоят обычные VPS, в том числе с VPN.
# Значение заменяет список целиком; с «+» в начале — дописывает к стандартному:
# vpn_whitelist_domains = +example.ru, example.com
# vpn_whitelist_domains = google.com, google.ru, youtube.com, youtu.be, googlevideo.com, ytimg.com, ggpht.com, gstatic.com, googleapis.com, gvt1.com, wikipedia.org, wikimedia.org, wikidata.org, wiktionary.org, vk.com, vk.ru, vk.me, userapi.com, vkuser.net, vkuseraudio.net, vkuservideo.net, vk-cdn.net, mycdn.me, ok.ru, mail.ru, imgsmail.ru, max.ru, oneme.ru, gosuslugi.ru, gov.ru, mos.ru, yandex.ru, yandex.net, yandex.com, ya.ru, yastatic.net, dzen.ru, rutube.ru, ozon.ru, wildberries.ru, wb.ru, avito.ru, sberbank.ru, sber.ru, tbank.ru, tinkoff.ru, vtb.ru
# vpn_whitelist_asn = 15169, 36040, 43515, 14907, 47541, 47764, 13238
